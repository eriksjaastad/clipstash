<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Per-user LaunchAgent template that starts the clipstash helper at login.

  ProgramArguments uses the @@CLIPSTASHD@@ placeholder. Two supported paths:

  1. Homebrew formula (packaging/homebrew/clipstash.rb):
       install the formula, then set ProgramArguments to
       $(brew --prefix)/bin/clipstashd
     (see packaging/homebrew/README.md for the brew install command).

  2. Single-binary install:
       ./scripts/build_macos_binary.sh
       ./scripts/install_macos_helper.sh
     The install script substitutes @@CLIPSTASHD@@ with ~/bin/clipstashd,
     copies this file to ~/Library/LaunchAgents/, and loads it for you.

  Manual install:
    mkdir -p ~/Library/LaunchAgents
    cp packaging/macos/com.clipstash.helper.plist ~/Library/LaunchAgents/
    # edit @@CLIPSTASHD@@ to the clipstashd path
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.clipstash.helper.plist

  Unload:
    launchctl bootout gui/$(id -u)/com.clipstash.helper

  Health check:
    curl http://127.0.0.1:8787/health

  The job runs at login only (RunAtLoad); launchd does not restart it if it
  exits. For Photoshop Automation consent, grant the program named in
  ProgramArguments (clipstashd) under System Settings → Privacy & Security →
  Automation, or start clipstashd from Terminal once to approve Terminal.
-->
<dict>
  <key>Label</key>
  <string>com.clipstash.helper</string>

  <key>ProgramArguments</key>
  <array>
    <string>@@CLIPSTASHD@@</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
