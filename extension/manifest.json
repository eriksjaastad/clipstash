{
  "manifest_version": 3,
  "name": "clipstash",
  "version": "0.1.0",
  "description": "Save video still + title + URL packets — not a clipboard manager.",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8787/picker/*"],
      "js": ["lib/picker-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*"
      ],
      "js": ["lib/urls.js", "lib/captured-overlay.js"],
      "css": ["lib/captured-overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "clipstash"
  },
  "options_page": "options.html"
}
